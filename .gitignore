# Keep stray Finder metadata out. Packaging/dmg.DS_Store is a deliberately named
# deterministic DMG layout artifact, not a local Finder .DS_Store.
.DS_Store
.build/
*.xcodeproj
.swiftpm/
DerivedData/
*.xcworkspace/
xcuserdata/
*.xcuserstate

*.dmg
dist/

.superpowers/
docs/
state/

*.log
*.tmp
*.swp
*.swo
__pycache__/
*.pyc

CLAUDE.md
GEMINI.md
AGENTS.md

/.env
.env
.env.*

*.pem
*.p12
*.key
*.mobileprovision
*.xcconfig

/.cache/
/.agents/
/.codex/

/state
state/
*/state/*
Packaging/icon-1024.png

