<Window x:Class="Tama.Tray.PinnedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tama.Tray.Views"
        Title="Tama"
        MinWidth="300" MinHeight="240"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{x:Static views:Palette.Panel}">
    <!-- The resizable, always-on-top pinned dashboard (spec §1b). Unlike the transient popover
         (PopoverWindow.xaml: borderless, AllowsTransparency, closes on Deactivated), this is a
         normal titled/closable/resizable chrome window — the only one of Tama's windows that is
         resizable, mirroring NSPanel's [.titled, .closable, .resizable, .utilityWindow,
         .nonactivatingPanel] styleMask. Topmost="True" is mac's `isFloatingPanel = true, level =
         .floating` (always-on-top of normal windows while shown — this IS the "pin" behavior, not
         a separately toggleable setting). Reused across pin/unpin (isReleasedWhenClosed = false —
         see code-behind's hide-not-destroy Closing handler and its frame-persistence pair with
         AppSettingsViewModel.PinnedFrame), hosting the SAME DashboardView content built with
         fixedWidth: false (no 300pt clamp — DashboardView.xaml.cs). -->
    <views:DashboardView x:Name="Dashboard" />
</Window>
