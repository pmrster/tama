<Window x:Class="Tama.Tray.FloatingCatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Tama.Tray.Views"
        Title="Tama"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <!-- The floating desktop cat: the Windows stand-in for the mac menu-bar cat. Borderless,
         transparent, always on top, never activated (WS_EX_NOACTIVATE is added in code-behind so a
         click here can't deactivate — and thereby close — the transient PopoverWindow).

         Root background is #01000000 on purpose: a layered (AllowsTransparency) window passes
         clicks THROUGH fully transparent pixels, so with alpha 0 only the cat's body pixels would
         be clickable/draggable. Alpha 1 is invisible but hit-testable. Root.Width/Height are set
         from FloatingCatPlacement in code-behind. -->
    <Grid x:Name="Root" Background="#01000000" Cursor="Hand"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp"
          MouseLeave="Root_MouseLeave"
          MouseRightButtonUp="Root_MouseRightButtonUp">
        <!-- PetControl's own strip (spriteW + 12 wide, 34 tall) scaled 2x via LayoutTransform —
             FloatingCatPlacement.DisplayScale. NearestNeighbor on its Image keeps the pixels crisp. -->
        <views:PetControl x:Name="Pet" Width="60" HorizontalAlignment="Center" VerticalAlignment="Center">
            <views:PetControl.LayoutTransform>
                <ScaleTransform ScaleX="2" ScaleY="2" />
            </views:PetControl.LayoutTransform>
        </views:PetControl>
    </Grid>
</Window>
